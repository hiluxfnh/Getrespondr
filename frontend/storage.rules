rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /incident-images/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /documents/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}