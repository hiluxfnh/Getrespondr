PORT=3001
SCAN_INTERVAL_MINUTES=5

# Path to Firebase service account JSON (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=../frontend/service-account.json

# Gemini API key for climate incident extraction
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Minimum AI confidence (0-1) to auto-create an incident
MIN_CONFIDENCE=0.55

# CORS origin for frontend dev server
CORS_ORIGIN=http://localhost:5173
